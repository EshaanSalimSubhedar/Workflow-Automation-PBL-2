<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="triageDefinitions" targetNamespace="http://camunda.io/labs" exporter="Camunda Modeler" exporterVersion="5.28.0"><bpmn:process id="patient_triage" name="Lab 3 - Patient Triage" isExecutable="true">
<bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="validate" name="Validate registration"><bpmn:extensionElements><zeebe:taskDefinition type="validate-appointment"/></bpmn:extensionElements><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="triage" name="Classify triage"><bpmn:extensionElements><zeebe:calledDecision decisionId="triage_decision" resultVariable="triageDecision"/></bpmn:extensionElements><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:businessRuleTask><bpmn:serviceTask id="slot" name="Find appointment slot"><bpmn:extensionElements><zeebe:taskDefinition type="find-slot"/></bpmn:extensionElements><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="route"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>fReview</bpmn:outgoing><bpmn:outgoing>fBooked</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="review" name="Authorized staff review"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="clinical-staff"/></bpmn:extensionElements><bpmn:incoming>fReview</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="booked" name="Booked"><bpmn:incoming>fBooked</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="staff" name="Staff intervention completed"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate"/><bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="triage"/><bpmn:sequenceFlow id="f3" sourceRef="triage" targetRef="slot"/><bpmn:sequenceFlow id="f4" sourceRef="slot" targetRef="route"/><bpmn:sequenceFlow id="fReview" sourceRef="route" targetRef="review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(slotAvailable) or triageDecision.category = "PRIORITY_REVIEW" or triageDecision.category = "URGENT_ASSESSMENT"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="fBooked" sourceRef="route" targetRef="booked"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable and triageDecision.category = "ROUTINE"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f5" sourceRef="review" targetRef="staff"/>
</bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_Triage"><bpmndi:BPMNPlane id="BPMNPlane_Triage" bpmnElement="patient_triage">
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="100" y="280" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="validate_di" bpmnElement="validate"><dc:Bounds x="190" y="258" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="triage_di" bpmnElement="triage"><dc:Bounds x="360" y="258" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="slot_di" bpmnElement="slot"><dc:Bounds x="530" y="258" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="route_di" bpmnElement="route" isMarkerVisible="true"><dc:Bounds x="700" y="273" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="800" y="258" width="130" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="booked_di" bpmnElement="booked"><dc:Bounds x="810" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="staff_di" bpmnElement="staff"><dc:Bounds x="1000" y="280" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="136" y="298"/><di:waypoint x="190" y="298"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="310" y="298"/><di:waypoint x="360" y="298"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="480" y="298"/><di:waypoint x="530" y="298"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="650" y="298"/><di:waypoint x="700" y="298"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="fReview_di" bpmnElement="fReview"><di:waypoint x="750" y="298"/><di:waypoint x="800" y="298"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="fBooked_di" bpmnElement="fBooked"><di:waypoint x="725" y="273"/><di:waypoint x="725" y="138"/><di:waypoint x="810" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="930" y="298"/><di:waypoint x="1000" y="298"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
