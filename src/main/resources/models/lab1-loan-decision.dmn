<?xml version="1.0" encoding="UTF-8"?><definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="loanDmn" name="LoanDecision" namespace="http://camunda.io/labs"><decision id="loan_decision" name="Loan decision"><decisionTable hitPolicy="FIRST"><input id="income"><inputExpression typeRef="number"><text>monthlyIncome</text></inputExpression></input><input id="amount"><inputExpression typeRef="number"><text>requestedAmount</text></inputExpression></input><input id="score"><inputExpression typeRef="number"><text>creditScore</text></inputExpression></input><output id="outcome" name="outcome" typeRef="string"/><rule><inputEntry><text>&gt;= 5000</text></inputEntry><inputEntry><text>&lt;= 50000</text></inputEntry><inputEntry><text>&gt;= 700</text></inputEntry><outputEntry><text>"APPROVED"</text></outputEntry></rule><rule><inputEntry><text>&gt;= 2500</text></inputEntry><inputEntry><text>&lt;= 100000</text></inputEntry><inputEntry><text>&gt;= 600</text></inputEntry><outputEntry><text>"MANUAL_REVIEW"</text></outputEntry></rule><rule><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><inputEntry><text>-</text></inputEntry><outputEntry><text>"REJECTED"</text></outputEntry></rule></decisionTable></decision></definitions>
